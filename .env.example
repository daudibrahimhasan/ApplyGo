# ApplyGo local diagnostic configuration for scripts/check-ai.js only.
# Configure the extension's key in its Settings UI instead.
# Copy to .env for the diagnostic; never commit a real key.
# Avoid VITE-prefixed real secrets: Vite can embed them in frontend bundles.
API_KEY=replace_me
VITE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VITE_AI_MODEL=your_supported_model_id

# Other OpenAI-compatible endpoints can be configured above.
# For Ollama, use a local endpoint and a model installed on your machine.
